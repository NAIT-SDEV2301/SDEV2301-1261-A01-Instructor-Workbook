@page "/counter"
@inject SingletonMarker SingletonA
@inject SingletonMarker SingletonB

@inject ScopedMarker ScopedA
@inject ScopedMarker ScopedB

@inject TransientMarker TransientA
@inject TransientMarker TransientB

<PageTitle>Counter</PageTitle>

<div>Services Demo</div>
<p>Singleton @SingletonA.InstanceId == Singleton @SingletonB.InstanceId</p>
<p>Scoped @ScopedA.InstanceId == Scoped @ScopedB.InstanceId</p>
<p>Transient @TransientA.InstanceId != @TransientB.InstanceId</p>


<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
