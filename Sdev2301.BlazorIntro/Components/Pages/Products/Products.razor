@page "/products"
@* @layout ProductLayout *@
@inject ProductDisplayService ProductDisplayService
@inject ProductService ProductService

<PageTitle>Products</PageTitle>
<h1>Products</h1>

<p>There are @_products.Count products.</p>
<p>Last refreshed: @DateTime.Now.ToLongTimeString()</p>


@if (_selectedProduct is not null)
{
    <div class="alert alert-info">
        @* Selected: @_selectedProduct.Name *@
        @ProductDisplayService.GetSummary(_selectedProduct)

        <p>@ProductDisplayService.GetPriceMessage(_selectedProduct)</p>
    </div>
}
@foreach (var product in _products)
{
    <ProductCard
        Item="@product"
        OnSelected="HandleProductSelected" />

<a class="btn btn-outline-primary"
href="@($"/products/{product.Id}")">
    Details
</a>

}
<EditForm Model="_formModel">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div>
        <label for="sku">Product Sku</label>
        <InputText id="sku"
            @bind-Value="_formModel.Sku"
            />
        <ValidationMessage For="@(() => _formModel.Sku)" />
    </div>

    <div>
        <label for="name">Product Name</label>
        <InputText id="name"
                   @bind-Value="_formModel.Name" />
        <ValidationMessage For="@(() => _formModel.Name)" />
    </div>

    <div>
        <label for="price">Price</label>
        <InputNumber id="price"
                   @bind-Value="_formModel.Price" />
        <ValidationMessage For="@(() => _formModel.Price)" />
    </div>

    <div>
        <label for="isactive">IsActive</label>
        <InputCheckbox id="isactive"
                     @bind-Value="_formModel.IsActive" />
        <ValidationMessage For="@(() => _formModel.IsActive)" />
    </div>

    <button type="submit">Add Product</button>
</EditForm>

@code {
    private ProductFormModel _formModel = new();

    private Product? _selectedProduct;

    private void HandleProductSelected(Product product)
    {
        _selectedProduct = product;
    }

  
    private List<Product> _products = [];

    private string NewProductName { get; set; } = string.Empty;

    private void AddProduct()
    {
        if (string.IsNullOrWhiteSpace(NewProductName))
        {
            return;
        }

        var nextNumber = _products.Count + 1;
        _products.Add(new Product
            {
                Id = nextNumber,
                Sku = $"NEW-{nextNumber:000}",
            // Name = $"Name Product {nextNumber}",
                Name = NewProductName.Trim(),
                Price = Random.Shared.Next(1, 99),
                IsActive = true
            });

        // Clear the product name field
        NewProductName = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        _products = await ProductService.GetAllAsync();
    }

}
